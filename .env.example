# Copy to .env.local and fill in. Never commit .env.local.

# --- Sign-in (Auth.js + Google) ---
AUTH_SECRET=                 # openssl rand -base64 32
AUTH_GOOGLE_ID=              # Google Cloud OAuth client id
AUTH_GOOGLE_SECRET=          # Google Cloud OAuth client secret
ALLOWED_EMAILS=              # comma-separated Google accounts allowed to sign in
TOKEN_ENCRYPTION_KEY=        # openssl rand -base64 32  (encrypts the stored Google token)

# --- Data ---
DATABASE_URL=                # Neon Postgres. Leave empty locally to use an embedded database in .data/
DEFAULT_TIMEZONE=Asia/Muscat

# --- AI (Neon AI Gateway) ---
NEON_AI_GATEWAY_BASE_URL=      # https://<branch-id>-api.ai.<region>.aws.neon.tech  (no path)
NEON_AI_GATEWAY_TOKEN=         # nt_live_...
# AI_MODEL_FAST=claude-haiku-5-5
# AI_MODEL_PLANNER=claude-sonnet-5-5

# --- Morning email ---
RESEND_API_KEY=
# RESEND_FROM=Daybrief <plan@yourdomain.com>
APP_URL=http://localhost:3000
CRON_SECRET=                 # openssl rand -hex 32  (Vercel sends it to /api/cron/daily)

# --- Local demo without Google: sample data, no sign-in. Ignored in production. ---
# DEMO_MODE=1
